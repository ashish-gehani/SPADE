mcp.host = $(config_file cfg/spade.utility.mcp.server.Main.config mcp.http.host.name)
mcp.port = $(config_file cfg/spade.utility.mcp.server.Main.config mcp.http.host.port)
mcp.endpoint = $(config_file cfg/spade.utility.mcp.server.Main.config mcp.http.host.endpoint)
# Expects 'anthropic' or 'mock'
llm.type = mock
# Required if llm.type is anthropic
#llm.anthropic.api.key =
#llm.anthropic.model = claude-sonnet-5
# Required if llm.type is mock; comma-separated names of the premade scenarios (see
# cfg/spade.utility.mcp.client.llm.mock.scenario.Registry.config) to replay, in order
llm.mock.scenarios = add_and_remove_neo4j_storage
# Expects 'cli' or 'web'
user.mode = cli
# Required if user.mode is web
#user.web.host = localhost
#user.web.port = 8081
verbose = false
