# Configuration for reporters extending AgentReporter.
#
# A subclass can override any key here in its own config file
# (cfg/spade.reporter.<SubclassName>.config); the subclass file wins.

# Truncation limit (characters) for the Entity `value` annotation. `value.hash`
# and `value.size` always describe the full untruncated payload, so identity
# stays exact even when the stored value is clipped.
maxPayloadLength=4096
