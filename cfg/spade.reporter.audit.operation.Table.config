# OPM operations, keyed by the operation in spade.reporter.audit.operation.Type:
#   <operation>.name = <operation name>
#   <operation>.syscalls = <comma-separated system call names> (optional)
# Every operation must have a non-blank name, and names must be unique. Quote names that contain spaces.
# System call names are as in the arch system call tables (cfg/spade.reporter.audit.arch.*.syscall.Table.config).

ACCEPT.name = accept
ACCEPT.syscalls = accept,accept4
BIND.name = bind
BIND.syscalls = bind
CHMOD.name = chmod
CHMOD.syscalls = chmod,fchmod,fchmodat
CLONE.name = clone
CLONE.syscalls = clone
CLOSE.name = close
CLOSE.syscalls = close
CONNECT.name = connect
CONNECT.syscalls = connect
CREATE.name = create
CREATE.syscalls = creat
DUP.name = dup
DUP.syscalls = dup,dup2,dup3
EXECVE.name = execve
EXECVE.syscalls = execve
EXIT.name = exit
EXIT.syscalls = exit,exit_group
FCNTL.name = fcntl
FCNTL.syscalls = fcntl
FORK.name = fork
FORK.syscalls = fork,vfork
LINK.name = link
LINK.syscalls = link,linkat,symlink,symlinkat
LOAD.name = load
LSEEK.name = lseek
LSEEK.syscalls = lseek
MADVISE.name = madvise
MADVISE.syscalls = madvise
MKNOD.name = mknod
MKNOD.syscalls = mknod,mknodat
MMAP.name = mmap
MMAP.syscalls = mmap
MPROTECT.name = mprotect
MPROTECT.syscalls = mprotect
OPEN.name = open
OPEN.syscalls = open,openat
PIPE.name = pipe
PIPE.syscalls = pipe,pipe2
PTRACE.name = ptrace
PTRACE.syscalls = ptrace
READ.name = read
READ.syscalls = read,readv,pread,preadv
RECV.name = recv
RECV.syscalls = recvfrom,recvmsg
RENAME.name = rename
RENAME.syscalls = rename,renameat
SEND.name = send
SEND.syscalls = sendmsg,sendto
SETGID.name = setgid
SETGID.syscalls = setgid,setregid,setresgid,setfsgid
SETUID.name = setuid
SETUID.syscalls = setuid,setreuid,setresuid,setfsuid
TRUNCATE.name = truncate
TRUNCATE.syscalls = truncate,ftruncate
UNIT.name = unit
UNIT_DEPENDENCY.name = "unit dependency"
UNKNOWN.name = unknown
UNLINK.name = unlink
UNLINK.syscalls = unlink,unlinkat
UPDATE.name = update
WRITE.name = write
WRITE.syscalls = write,writev,pwrite,pwritev
TEE.name = tee
TEE.syscalls = tee
SPLICE.name = splice
SPLICE.syscalls = splice
VMSPLICE.name = vmsplice
VMSPLICE.syscalls = vmsplice
INIT_MODULE.name = init_module
INIT_MODULE.syscalls = init_module
FINIT_MODULE.name = finit_module
FINIT_MODULE.syscalls = finit_module
KILL.name = kill
KILL.syscalls = kill
SETNS.name = setns
SETNS.syscalls = setns
UNSHARE.name = unshare
UNSHARE.syscalls = unshare
MSGGET.name = msgget
MSGGET.syscalls = msgget
MSGCTL.name = msgctl
MSGCTL.syscalls = msgctl
MSGSND.name = msgsnd
MSGSND.syscalls = msgsnd
MSGRCV.name = msgrcv
MSGRCV.syscalls = msgrcv
SHMGET.name = shmget
SHMGET.syscalls = shmget
SHMAT.name = shmat
SHMAT.syscalls = shmat
SHMCTL.name = shmctl
SHMCTL.syscalls = shmctl
MQ_OPEN.name = mq_open
MQ_OPEN.syscalls = mq_open
MQ_TIMEDSEND.name = mq_timedsend
MQ_TIMEDSEND.syscalls = mq_timedsend
MQ_TIMEDRECEIVE.name = mq_timedreceive
MQ_TIMEDRECEIVE.syscalls = mq_timedreceive
MQ_UNLINK.name = mq_unlink
MQ_UNLINK.syscalls = mq_unlink
