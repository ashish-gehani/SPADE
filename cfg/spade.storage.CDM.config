# Change the keys in the code of Kafka and CDM storages too if changed here

# Output file path for the file writer. Setting this enables the file writer; leaving it unset
# (the default) uses the server writer instead.
#kafka.output.file=/path/to/output/file

kafka.schema=cfg/spade.storage.CDM.avsc
kafka.output.server=localhost:9094
kafka.output.topic=ta1-trace-cdm18
kafka.output.producer.id=SPADE

cdm.host.file=cfg/spade.utility.HostInfo.out

# Encode UUIDs as hex strings instead of raw bytes. Optional, defaults to false.
#cdm.hex.uuids=false

# Session number to record with this run. Optional; if unset, CDM reads the last used
# session number from its own output-tracking file and increments it.
#cdm.session=0

# Regenerate the host info file from the OS at startup instead of reading an existing one.
# Optional, defaults to true.
#cdm.create.host.config=true

# Whether to use SSL for the Kafka server connection. Optional, defaults to true. The
# cdm.ssl.* keys below are only required when this is true and the server writer is active
# (i.e. kafka.output.file is unset, or one of the kafka.output.server/topic/producer.id keys is set).
#cdm.ssl=true

# SSL configuration
cdm.ssl.security.protocol=SSL
cdm.ssl.trust.store.location=/var/private/ssl/kafka.client.truststore.jks
cdm.ssl.trust.store.password=
cdm.ssl.key.store.location=/var/private/ssl/kafka.client.keystore.jks
cdm.ssl.key.store.password=
cdm.ssl.key.password=

# How often (in seconds) to log CDM record-count stats.
cdm.reporting.interval.seconds=120
