# Scenario 1: add a storage, then remove it, back to the original (empty) state
mock.scenario.1.name = add_and_remove_neo4j_storage
mock.scenario.1.tool.1.name = list_storages_before
mock.scenario.1.tool.1.tool.name = list_storages
mock.scenario.1.tool.1.input = {}
mock.scenario.1.tool.1.result = No storages added
mock.scenario.1.tool.2.name = add_storage_neo4j
mock.scenario.1.tool.2.tool.name = add_storage
mock.scenario.1.tool.2.input = {"storageName": "Neo4j"}
mock.scenario.1.tool.2.result = Adding storage Neo4j... done.
mock.scenario.1.tool.3.name = remove_storage_neo4j
mock.scenario.1.tool.3.tool.name = remove_storage
mock.scenario.1.tool.3.input = {"storageName": "Neo4j"}
mock.scenario.1.tool.3.result = Shutting down storage Neo4j... done (0 vertices and 0 edges added)
