# Scenario 1: add a storage, then remove it, back to the original (empty) state
mock.scenario.1.name = add_and_remove_neo4j_storage
mock.scenario.1.tool.1.name = list_storages_before
mock.scenario.1.tool.1.tool.name = spade_control
mock.scenario.1.tool.1.input = {"command": "list storages"}
mock.scenario.1.tool.1.result = No storages added
mock.scenario.1.tool.2.name = add_storage_neo4j
mock.scenario.1.tool.2.tool.name = spade_control
mock.scenario.1.tool.2.input = {"command": "add storage Neo4j"}
mock.scenario.1.tool.2.result = Adding storage Neo4j... done.
mock.scenario.1.tool.3.name = remove_storage_neo4j
mock.scenario.1.tool.3.tool.name = spade_control
mock.scenario.1.tool.3.input = {"command": "remove storage Neo4j"}
mock.scenario.1.tool.3.result = Shutting down storage Neo4j... done (0 vertices and 0 edges added)

# Scenario 2: add a storage and analyzer, then query the base graph's stats
mock.scenario.2.name = query_base_stats
mock.scenario.2.tool.1.name = add_storage_neo4j
mock.scenario.2.tool.1.tool.name = spade_control
mock.scenario.2.tool.1.input = {"command": "add storage Neo4j"}
mock.scenario.2.tool.1.result = Adding storage Neo4j... done.
mock.scenario.2.tool.2.name = set_storage_neo4j
mock.scenario.2.tool.2.tool.name = spade_control
mock.scenario.2.tool.2.input = {"command": "set storage Neo4j"}
mock.scenario.2.tool.2.result = Setting default query storage Neo4j... done
mock.scenario.2.tool.3.name = add_analyzer_commandline
mock.scenario.2.tool.3.tool.name = spade_control
mock.scenario.2.tool.3.input = {"command": "add analyzer CommandLine"}
mock.scenario.2.tool.3.result = Adding analyzer CommandLine... done
mock.scenario.2.tool.4.name = stat_base
mock.scenario.2.tool.4.tool.name = spade_query
mock.scenario.2.tool.4.input = {"command": "stat $base"}
mock.scenario.2.tool.4.result = $(text_file cfg/spade.utility.mcp.client.llm.mock.scenario.Registry/mock.scenario.2/tool.4.result.txt)
mock.scenario.2.tool.5.name = remove_analyzer_commandline
mock.scenario.2.tool.5.tool.name = spade_control
mock.scenario.2.tool.5.input = {"command": "remove analyzer CommandLine"}
mock.scenario.2.tool.5.result = Shutting down analyzer CommandLine... done
mock.scenario.2.tool.6.name = remove_storage_neo4j
mock.scenario.2.tool.6.tool.name = spade_control
mock.scenario.2.tool.6.input = {"command": "remove storage Neo4j"}
mock.scenario.2.tool.6.result = Shutting down storage Neo4j... done (0 vertices and 0 edges added)
