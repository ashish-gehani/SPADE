    <spade.package.lib.dir>../../lib</spade.package.lib.dir>
    <spade.package.jar.path>${spade.package.lib.dir}/${spade.jar.name}</spade.package.jar.path>
    <spade.package.header.include.java.dir>../../include/java</spade.package.header.include.java.dir>

