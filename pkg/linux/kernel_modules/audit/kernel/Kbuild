# Object list for audit/kernel, included by the top-level Kbuild via `include audit/kernel/Kbuild`.
# Paths are relative to the Kbuild source root ($(src)), not to this directory.

# Function names (arch-specific: audit/kernel/arch/x86_64/Kbuild, audit/kernel/arch/arm64/Kbuild)
UNAME_M := $(shell uname -m)
# uname -m reports 'aarch64', but the kernel's own ARCH= naming (and this project's directory name)
# is 'arm64' -- mapped here rather than naming the directory after uname -m's raw output.
ifeq ($(UNAME_M),aarch64)
KERNEL_ARCH_DIR := arm64
else
KERNEL_ARCH_DIR := $(UNAME_M)
endif
ifeq ($(wildcard $(MODULE_SRC_DIR)/audit/kernel/arch/$(KERNEL_ARCH_DIR)/Kbuild),)
$(error Unsupported architecture: $(UNAME_M) (expected x86_64 or aarch64))
endif
include $(MODULE_SRC_DIR)/audit/kernel/arch/$(KERNEL_ARCH_DIR)/Kbuild

# Common (arch-independent) object list: audit/kernel/arch/common/Kbuild
include $(MODULE_SRC_DIR)/audit/kernel/arch/common/Kbuild

HOOKED_FUNCTION_ACTION_HARDEN_NAMES := \
  sys_kill

# Functions whose action.c / action/audit.c / op.c (arch-independent files) have moved to
# audit/kernel/arch/common/function/ (built via COMMON_FUNCTION_OBJS instead), so excluded from
# the per-arch foreach-generated object lists below. hook.c stays arch-specific regardless, so
# hook.o is not filtered by this.
COMMON_FUNCTION_NAMES := \
  sys_accept \
  sys_accept4 \
  sys_bind \
  sys_clone \
  sys_connect \
  sys_fork \
  sys_kill \
  sys_recvfrom \
  sys_recvmsg \
  sys_sendmsg \
  sys_sendto \
  sys_setns \
  sys_unshare \
  sys_vfork

HOOKED_FUNCTION_ACTION_AUDIT_OBJS := \
  $(foreach f_name,$(filter-out $(COMMON_FUNCTION_NAMES),$(HOOKED_FUNCTION_ACTION_AUDIT_NAMES)),audit/kernel/arch/$(KERNEL_ARCH_DIR)/function/$(f_name)/action/audit.o)

HOOKED_FUNCTION_ACTION_HARDEN_OBJS := \
  $(foreach f_name,$(filter-out $(COMMON_FUNCTION_NAMES),$(HOOKED_FUNCTION_ACTION_HARDEN_NAMES)),audit/kernel/arch/$(KERNEL_ARCH_DIR)/function/$(f_name)/action/harden.o)

HOOKED_FUNCTION_OBJS := \
  $(HOOKED_FUNCTION_ACTION_AUDIT_OBJS) \
  $(HOOKED_FUNCTION_ACTION_HARDEN_OBJS) \
  $(foreach f_name,$(filter-out $(COMMON_FUNCTION_NAMES),$(HOOKED_FUNCTION_NAMES)),audit/kernel/arch/$(KERNEL_ARCH_DIR)/function/$(f_name)/action.o) \
  $(foreach f_name,$(HOOKED_FUNCTION_NAMES),audit/kernel/arch/$(KERNEL_ARCH_DIR)/function/$(f_name)/hook.o) \
  $(foreach f_name,$(filter-out $(COMMON_FUNCTION_NAMES),$(HOOKED_FUNCTION_NAMES)),audit/kernel/arch/$(KERNEL_ARCH_DIR)/function/$(f_name)/op.o)

KERNEL_OBJS := \
  audit/kernel/arch/$(KERNEL_ARCH_DIR)/function/op.o \
  audit/kernel/arch/$(KERNEL_ARCH_DIR)/function/number.o \
  $(ARCH_SETUP_FUNCTION_FTRACE_OBJS) \
  $(COMMON_OBJS) \
  $(HOOKED_FUNCTION_OBJS)
