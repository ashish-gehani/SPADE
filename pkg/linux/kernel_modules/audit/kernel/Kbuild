# Object list for audit/kernel, included by the top-level Kbuild via `include audit/kernel/Kbuild`.
# Paths are relative to the Kbuild source root ($(src)), not to this directory.

# Function names (arch-specific: audit/kernel/arch/x86_64/Kbuild, audit/kernel/arch/aarch64/Kbuild)
UNAME_M := $(shell uname -m)
ifeq ($(wildcard $(MODULE_SRC_DIR)/audit/kernel/arch/$(UNAME_M)/Kbuild),)
$(error Unsupported architecture: $(UNAME_M) (expected x86_64 or aarch64))
endif
include $(MODULE_SRC_DIR)/audit/kernel/arch/$(UNAME_M)/Kbuild

# Common (arch-independent) object list: audit/kernel/arch/common/Kbuild
include $(MODULE_SRC_DIR)/audit/kernel/arch/common/Kbuild

HOOKED_FUNCTION_ACTION_HARDEN_NAMES := \
  sys_kill

# Functions whose action.c / action/audit.c / op.c (arch-independent files) have moved to
# audit/kernel/arch/common/function/ (built via COMMON_FUNCTION_OBJS instead), so excluded from
# the per-arch foreach-generated object lists below. hook.c stays arch-specific regardless, so
# hook.o is not filtered by this.
COMMON_FUNCTION_NAMES := \
  sys_accept \
  sys_accept4 \
  sys_bind \
  sys_clone \
  sys_connect \
  sys_fork \
  sys_kill

HOOKED_FUNCTION_ACTION_AUDIT_OBJS := \
  $(foreach f_name,$(filter-out $(COMMON_FUNCTION_NAMES),$(HOOKED_FUNCTION_ACTION_AUDIT_NAMES)),audit/kernel/arch/$(UNAME_M)/function/$(f_name)/action/audit.o)

HOOKED_FUNCTION_ACTION_HARDEN_OBJS := \
  $(foreach f_name,$(filter-out $(COMMON_FUNCTION_NAMES),$(HOOKED_FUNCTION_ACTION_HARDEN_NAMES)),audit/kernel/arch/$(UNAME_M)/function/$(f_name)/action/harden.o)

HOOKED_FUNCTION_OBJS := \
  $(HOOKED_FUNCTION_ACTION_AUDIT_OBJS) \
  $(HOOKED_FUNCTION_ACTION_HARDEN_OBJS) \
  $(foreach f_name,$(filter-out $(COMMON_FUNCTION_NAMES),$(HOOKED_FUNCTION_NAMES)),audit/kernel/arch/$(UNAME_M)/function/$(f_name)/action.o) \
  $(foreach f_name,$(HOOKED_FUNCTION_NAMES),audit/kernel/arch/$(UNAME_M)/function/$(f_name)/hook.o) \
  $(foreach f_name,$(filter-out $(COMMON_FUNCTION_NAMES),$(HOOKED_FUNCTION_NAMES)),audit/kernel/arch/$(UNAME_M)/function/$(f_name)/op.o)

KERNEL_OBJS := \
  audit/kernel/arch/$(UNAME_M)/function/op.o \
  audit/kernel/arch/$(UNAME_M)/function/number.o \
  $(ARCH_SETUP_FUNCTION_FTRACE_OBJS) \
  $(COMMON_OBJS) \
  $(HOOKED_FUNCTION_OBJS)
