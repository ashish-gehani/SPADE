# x86_64-specific hooked function names and object list, included by audit/kernel/Kbuild.
# Paths are relative to the Kbuild source root ($(src)), not to this directory.

ARCH_X86_64_HOOKED_FUNCTIONS_NAMES := \
  sys_accept \
  sys_accept4 \
  sys_bind \
  sys_clone \
  sys_connect \
  sys_fork \
  sys_kill \
  sys_recvfrom \
  sys_recvmsg \
  sys_sendmsg \
  sys_sendto \
  sys_setns \
  sys_unshare \
  sys_vfork

ARCH_X86_64_SETUP_FUNCTION_FTRACE_OBJS := \
  audit/kernel/arch/x86_64/setup/function/ftrace/ftrace_thunk.o

ARCH_X86_64_FUNCTION_HOOK_OBJS := \
  $(foreach f_name,$(ARCH_X86_64_HOOKED_FUNCTIONS_NAMES),audit/kernel/arch/x86_64/function/$(f_name)/hook.o)

ARCH_X86_64_FUNCTION_OBJS := \
  audit/kernel/arch/x86_64/function/op.o \
  audit/kernel/arch/x86_64/function/number.o \
  $(ARCH_X86_64_FUNCTION_HOOK_OBJS)

ARCH_X86_64_OBJS := \
  $(ARCH_X86_64_SETUP_FUNCTION_FTRACE_OBJS) \
  $(ARCH_X86_64_FUNCTION_OBJS)
