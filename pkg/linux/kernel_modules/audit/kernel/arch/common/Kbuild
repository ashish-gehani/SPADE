# Object list for audit/kernel/arch/common, included by the top-level audit/kernel/Kbuild.
# Paths are relative to the Kbuild source root ($(src)), not to this directory.

# Names of hooked functions whose action.c / action/audit.c / op.c (arch-independent files) live
# here instead of per-arch. Consumed by the top-level audit/kernel/Kbuild via
# $(filter-out $(ARCH_COMMON_FUNCTION_NAMES), ...) to exclude them from its per-arch foreach-generated
# object lists. hook.c stays arch-specific regardless, so hook.o is not filtered by this.
ARCH_COMMON_FUNCTION_NAMES := \
  sys_accept \
  sys_accept4 \
  sys_bind \
  sys_clone \
  sys_connect \
  sys_fork \
  sys_kill \
  sys_recvfrom \
  sys_recvmsg \
  sys_sendmsg \
  sys_sendto \
  sys_setns \
  sys_unshare \
  sys_vfork

ARCH_COMMON_HELPER_OBJS := \
  audit/kernel/arch/common/helper/audit_log.o \
  audit/kernel/arch/common/helper/kernel.o \
  audit/kernel/arch/common/helper/namespace.o \
  audit/kernel/arch/common/helper/network.o \
  audit/kernel/arch/common/helper/sock.o \
  audit/kernel/arch/common/helper/task.o

ARCH_COMMON_NAMESPACE_OBJS := \
  audit/kernel/arch/common/namespace/namespace.o

ARCH_COMMON_NETFILTER_OBJS := \
  audit/kernel/arch/common/netfilter/netfilter.o

ARCH_COMMON_SETUP_NETFILTER_OBJS := \
  audit/kernel/arch/common/setup/netfilter/netfilter.o

ARCH_COMMON_SETUP_NAMESPACE_OBJS := \
  audit/kernel/arch/common/setup/namespace/namespace.o

ARCH_COMMON_SETUP_FUNCTION_FTRACE_OBJS := \
  audit/kernel/arch/common/setup/function/ftrace/ftrace.o \
  audit/kernel/arch/common/setup/function/ftrace/ftrace_helper.o \
  audit/kernel/arch/common/setup/function/ftrace/ftrace_thunk.o

# Per-function object lists. Named ARCH_COMMON_FUNCTION_SYS_<NAME>_OBJS (not e.g. just <NAME>_OBJS) to
# stay unique in Kbuild's single flat variable namespace -- every Kbuild file here is pulled in via
# `include`, not scoped per-file, so a collision with a like-named variable from another included
# Kbuild (arch-specific or top-level) would silently clobber one or the other.
ARCH_COMMON_FUNCTION_SYS_ACCEPT_OBJS := \
  audit/kernel/arch/common/function/sys_accept/action.o \
  audit/kernel/arch/common/function/sys_accept/action/audit.o \
  audit/kernel/arch/common/function/sys_accept/op.o \
  audit/kernel/arch/common/function/sys_accept/hook.o

