# arm64-specific hooked function names and object list, included by audit/kernel/Kbuild.
# Paths are relative to the Kbuild source root ($(src)), not to this directory.

# aarch64's native 64-bit ABI has no SYS_fork / SYS_vfork syscall numbers;
# glibc's fork()/vfork() are implemented via clone() on this architecture, so
# sys_fork/sys_vfork are excluded here since they are unreachable from
# userspace.
ARCH_ARM64_HOOKED_FUNCTIONS_NAMES := \
  sys_accept \
  sys_accept4 \
  sys_bind \
  sys_clone \
  sys_connect \
  sys_kill \
  sys_recvfrom \
  sys_recvmsg \
  sys_sendmsg \
  sys_sendto \
  sys_setns \
  sys_unshare

ARCH_ARM64_SETUP_FUNCTION_FTRACE_OBJS := \
  audit/kernel/arch/arm64/setup/function/ftrace/ftrace_thunk.o

ARCH_ARM64_FUNCTION_HOOK_OBJS := \
  $(foreach f_name,$(ARCH_ARM64_HOOKED_FUNCTIONS_NAMES),audit/kernel/arch/arm64/function/$(f_name)/hook.o)

ARCH_ARM64_FUNCTION_OBJS := \
  audit/kernel/arch/arm64/function/op.o \
  audit/kernel/arch/arm64/function/number.o \
  $(ARCH_ARM64_FUNCTION_HOOK_OBJS)

ARCH_ARM64_OBJS := \
  $(ARCH_ARM64_SETUP_FUNCTION_FTRACE_OBJS) \
  $(ARCH_ARM64_FUNCTION_OBJS)
