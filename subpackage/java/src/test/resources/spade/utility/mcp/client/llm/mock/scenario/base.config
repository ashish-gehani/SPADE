# used by RegistryTest; two scenarios, the first with two tool calls, the second with one
mock.scenario.1.name = list_then_query
mock.scenario.1.tool.1.name = list_storages_step
mock.scenario.1.tool.1.tool.name = spade_control
mock.scenario.1.tool.1.input = {}
mock.scenario.1.tool.1.result = No storages added.
mock.scenario.1.tool.2.name = query_step
mock.scenario.1.tool.2.tool.name = spade_query
mock.scenario.1.tool.2.input = {"command": "stat $base"}
mock.scenario.1.tool.2.result = OK
mock.scenario.2.name = second_scenario
mock.scenario.2.tool.1.name = print_step
mock.scenario.2.tool.1.tool.name = spade_control
mock.scenario.2.tool.1.input = {}
mock.scenario.2.tool.1.result = Printed.
